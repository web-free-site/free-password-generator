---
import { CipherText } from './cipher-text';
import { Container } from './container';
import type { Locale } from '@/i18n/messages';
import { t } from '@/i18n/messages';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const brand = locale === 'fr' ? 'FPG' : 'FPG';
---

<section class="hero">
  <Container>
    <div class="moon">
      <div class="moon-mask"></div>
    </div>
    <div class="title">
      <div class="logo"><img alt="Free Password Generator" src="/logo.svg" /></div>
      <h1>
        <span class="first">{t(locale, 'heroLine1')}</span>
        <span class="second">{t(locale, 'heroLine2')}</span>
        <span class="third">{t(locale, 'heroLine3')}</span>
      </h1>
    </div>
    <p>
      {`${t(locale, 'heroSub')} `}
      <span><CipherText client:load text={brand} /></span>
    </p>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    padding: 100px 0 40px;
    overflow-x: hidden;
    text-align: center;

    & .moon {
      position: absolute;
      top: 48px;
      left: 50%;
      z-index: -2;
      transform: translateX(-50%);

      & .moon-mask {
        width: 100vw;
        max-width: 450px;
        height: auto;
        aspect-ratio: 2 / 1;
        background: var(--color-neutral-100);
        border-radius: 9999px 9999px 0 0;
        box-shadow:
          inset 0 2px 0 var(--color-neutral-800),
          inset 0 2px 10px var(--color-neutral-600);
        opacity: 0.4;
        mask-image: linear-gradient(#000, transparent);
      }

      &::before {
        position: absolute;
        inset: -10px;
        content: '';
        border: 1px solid var(--color-neutral-300);
        border-radius: 9999px 9999px 0 0;
        mask-image: linear-gradient(#000, transparent);
      }

      &::after {
        position: absolute;
        inset: -20px;
        content: '';
        border: 1px solid var(--color-neutral-100);
        border-radius: 9999px 9999px 0 0;
        mask-image: linear-gradient(#000, transparent);
      }
    }

    & .logo {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 54px;
      height: 54px;
      margin: 0 auto 16px;
      background: linear-gradient(
        var(--color-neutral-200),
        var(--color-neutral-50),
        var(--color-neutral-50)
      );
      border: 1px solid var(--color-neutral-200);
      border-radius: 18px;
      box-shadow:
        inset 0 -1px 0 var(--color-neutral-100),
        inset 0 1px 0 var(--color-neutral-600);

      & img {
        height: 55%;
        opacity: 1;
      }
    }

    & h1 {
      margin-bottom: 4px;
      font-family: var(--font-display);
      font-size: var(--font-lg);
      font-weight: 700;
      line-height: 1.1;
      text-transform: capitalize;

      & .first,
      & .second,
      & .third {
        display: block;
      }

      & .second {
        color: var(--color-foreground-subtle);
      }

      & .third {
        color: var(--color-foreground-subtler);
      }
    }

    & p {
      height: 1.4rem;
      margin-top: 16px;
      font-size: var(--font-sm);
      color: var(--color-foreground-subtler);

      & span {
        font-family: var(--font-mono);
        color: var(--color-foreground-subtle);
      }
    }
  }
</style>