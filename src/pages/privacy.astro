---
import Layout from '@/layouts/layout.astro';
import PageChrome from '@/components/page-chrome.astro';
import LegalPage from '@/components/legal-page.astro';
import { SITE } from '@/lib/site';
---

<Layout
  title="Privacy policy — Free Password Generator"
  description="Privacy policy for Free Password Generator: client-side only, no password collection, no accounts."
  path="/privacy/"
>
  <PageChrome>
    <LegalPage title="Privacy" description="" path="/privacy/" heading="Privacy policy">
      <p>
        {SITE.name} runs entirely in your browser. When you generate a password, PIN, or passphrase, the
        computation happens on your device. We do not receive, log, or store the values you create.
      </p>
      <h2>Data we do not collect</h2>
      <p>
        There is no sign-up, no backend API, and no database tied to this tool. We do not ask for your
        name, email, or payment details to use the generator.
      </p>
      <h2>Local storage</h2>
      <p>
        The app may save your generator preferences (such as length or toggles) in your browser’s
        local storage so settings persist between visits. Clear site data in your browser to remove
        them.
      </p>
      <h2>Advertising</h2>
      <p>
        Third-party ad partners may set cookies or use similar technologies as described in their own
        policies. Ad banner scripts are loaded in isolated frames where possible.
      </p>
      <h2>Contact</h2>
      <p>
        Questions: see our <a href="/contact/">contact page</a> or the hub at
        <a href={SITE.hubUrl}>web-free.site</a>.
      </p>
    </LegalPage>
  </PageChrome>
</Layout>