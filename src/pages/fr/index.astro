---
import Layout from '@/layouts/layout.astro';
import { App } from '@/components/app';
import Hero from '@/components/hero.astro';
import Description from '@/components/description.astro';
import PageChrome from '@/components/page-chrome.astro';
import FaqSection from '@/components/faq-section.astro';
import { HOME_SEO } from '@/lib/seo';

const seo = HOME_SEO.fr;
---

<Layout
  title={seo.title}
  description={seo.description}
  path="/fr/"
  locale="fr"
  faq={seo.faq}
>
  <PageChrome locale="fr" showHomeTop showToolAds>
    <Hero locale="fr" />
    <App client:load locale="fr" />
    <Description locale="fr" />
    <FaqSection locale="fr" faq={seo.faq} />
  </PageChrome>
</Layout>