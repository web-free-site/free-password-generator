---
import Layout from '@/layouts/layout.astro';
import PageChrome from '@/components/page-chrome.astro';
import LegalPage from '@/components/legal-page.astro';
import { SITE } from '@/lib/site';
---

<Layout
  title="Terms of use — Free Password Generator"
  description="Terms for using Free Password Generator — provided as-is, client-side security tool."
  path="/terms/"
>
  <PageChrome>
    <LegalPage title="Terms" description="" path="/terms/" heading="Terms of use">
      <p>
        {SITE.name} is offered free of charge on an “as is” basis. By using the site you agree to these
        terms.
      </p>
      <h2>Your responsibility</h2>
      <p>
        You are responsible for how you use generated passwords and for keeping backups in a password
        manager. We are not liable for account compromise, loss, or damages arising from use of the
        tool.
      </p>
      <h2>No warranty</h2>
      <p>
        We do not guarantee uninterrupted service or that generated secrets meet any particular
        compliance regime. Verify requirements for your organization separately.
      </p>
      <h2>Open source</h2>
      <p>
        Core generator code is derived from <a href="https://github.com/remvze/pswd">remvze/pswd</a> (MIT
        License). See <a href="/about/">About</a> for attribution.
      </p>
      <h2>Changes</h2>
      <p>
        We may update these terms or the site; continued use after changes constitutes acceptance. Hosted
        via <a href={SITE.hubUrl}>web-free.site</a>.
      </p>
    </LegalPage>
  </PageChrome>
</Layout>